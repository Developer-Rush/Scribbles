RewriteEngine On

# Any unmatched/invalid URL serves the custom 404 page (still returns a
# real 404 status code, so search engines correctly treat it as not found).
ErrorDocument 404 /404

# /index or /index.html should always redirect to the site root,
# never show as its own URL.
RewriteRule ^index(\.html)?$ / [NC,L,R=301]

# If someone requests a page with the .html extension directly,
# send them to the clean, extension-less URL (avoids duplicate URLs
# for the same page and keeps the address bar clean everywhere).
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [NC,L,R=301]

# Internally serve the matching .html file for a clean URL request,
# without changing what shows in the address bar.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]
